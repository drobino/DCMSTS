# Copy to .env (never commit real values) and export before running.
DCMSTS_SECRET_KEY=change-me-to-a-long-random-string   # python -c "import secrets; print(secrets.token_hex(32))"
DCMSTS_DATABASE_URL=sqlite:////var/lib/dcmsts/dcmsts.db  # or postgresql+psycopg://user:pass@host/dcmsts
DCMSTS_UPLOAD_DIR=/var/lib/dcmsts/uploads
DCMSTS_BACKUP_DIR=/var/backups/dcmsts
DCMSTS_BACKUP_RETENTION=14
DCMSTS_COOKIE_SECURE=1          # set 0 only for local http development
DCMSTS_IDLE_TIMEOUT_MINUTES=30
# Email delivery; when DCMSTS_SMTP_HOST is unset notifications are logged and shown in each user's Inbox.
DCMSTS_SMTP_HOST=
DCMSTS_SMTP_PORT=587
DCMSTS_SMTP_USER=
DCMSTS_SMTP_PASSWORD=
DCMSTS_SMTP_FROM=dcmsts@example.org
